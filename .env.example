# Copy to .env and fill only the credentials you use.
# Never commit .env.
SI_LAB_API_KEY=
OPENROUTER_API_KEY=

# Native System-One/Ollama endpoint used by SI-Lab evaluator.
SI_LAB_OLLAMA_BASE_URL=http://127.0.0.1:11435

# OpenRouter decision model (default: openai/gpt-6-luna-decisions)
OPENROUTER_DECISION_MODEL=openai/gpt-6-luna-decisions

